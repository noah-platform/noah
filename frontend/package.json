{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' react-router dev",
    "start": "NODE_OPTIONS='--import ./instrument.server.mjs' react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "generate": "react-router typegen && openapi-merge-cli --config openapi-merge.json && openapi-typescript ./app/clients/openapi.yaml -o ./app/clients/openapi.ts --properties-required-by-default",
    "postinstall": "pnpm run generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-router/node": "^7.1.5",
    "@react-router/serve": "^7.1.5",
    "@sentry/node": "^9.1.0",
    "@sentry/profiling-node": "^9.1.0",
    "@sentry/react": "^9.1.0",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "isbot": "^5.1.17",
    "lucide-react": "^0.475.0",
    "nuqs": "^2.4.0",
    "openapi-fetch": "^0.13.4",
    "openapi-react-query": "^0.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-router": "^7.1.5",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@react-router/dev": "^7.1.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/google.accounts": "^0.0.15",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "openapi-merge-cli": "^1.3.2",
    "openapi-typescript": "^7.6.1",
    "react-router-devtools": "^1.1.0",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
